# 기본 텍스트 파일들 - 자동 줄바꿈 정규화
* text=auto

# Unity 관련 파일 - 무조건 LF로 고정
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# 바이너리 - diff 비활성화
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.fbx binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary