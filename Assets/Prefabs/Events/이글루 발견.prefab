      propertyPath: choices.Array.data[1].possibleOutcomes.Array.data[0].resultText
      value: "\uC218\uC0C1\uD588\uB358 \uC0C1\uC790\uB97C \uACF5\uACA9\uD574 \uBD80\uC218\uC790
