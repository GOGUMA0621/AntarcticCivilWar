      propertyPath: choices.Array.data[0].possibleOutcomes.Array.data[0].resultText
      value: "\uC774\uAE00\uB8E8\uB97C \uC57D\uD0C8\uD558\uC5EC \uC4F8\uB9CC\uD55C
        \uBB3C\uD488\uC744 \uAC00\uC838\uC654\uB2E4!"
