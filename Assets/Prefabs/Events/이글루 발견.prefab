    - target: {fileID: 2114954977177382356, guid: 662d4c574dfb58d4dbea36ca78f100ba, type: 3}
      propertyPath: choices.Array.data[0].possibleOutcomes.Array.data[1].resultText
      value: "\"\uC774\uAE00\uB8E8\uB97C \uC57D\uD0C8\uD558\uC790 \uC774\uAE00\uB8E8
        \uC548\uC5D0\uC788\uB358 \uAC70\uC8FC\uBBFC\uB4E4\uC774 \uC800\uD56D\uD558\uAE30
        \uC2DC\uC791\uD588\uB2E4!\""
      objectReference: {fileID: 0}
    - target: {fileID: 2114954977177382356, guid: 662d4c574dfb58d4dbea36ca78f100ba, type: 3}
      propertyPath: choices.Array.data[1].possibleOutcomes.Array.data[0].goldReward
