      propertyPath: choices.Array.data[0].possibleOutcomes.Array.data[0].resultText
      value: "\uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC0C1\uC790\uB97C \uC5F4\uC790 \uC548\uC5D0\uB294
