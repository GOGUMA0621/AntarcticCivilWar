    - target: {fileID: 2114954977177382356, guid: 662d4c574dfb58d4dbea36ca78f100ba, type: 3}
      propertyPath: choices.Array.data[0].possibleOutcomes.Array.data[1].resultText
      value: "\uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC0C1\uC790\uB97C \uC5F4\uC790 \uD2B8\uB7A9\uC774
        \uC791\uB3D9\uB418\uC5B4 \uD3ED\uBC1C\uC774 \uC77C\uC5B4\uB0AC\uACE0 \uC544\uAD70
        \uBB34\uB9AC\uB294 \uBD80\uC0C1\uC744 \uC785\uC5C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 2114954977177382356, guid: 662d4c574dfb58d4dbea36ca78f100ba, type: 3}
